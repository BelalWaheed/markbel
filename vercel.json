{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "backend/api/index.ts",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/api/index.ts" },
    { "src": "/sw.js", "dest": "frontend/sw.js" },
    { "src": "/manifest.json", "dest": "frontend/manifest.json" },
    { "src": "/logo.png", "dest": "frontend/logo.png" },
    { "src": "/assets/(.*)", "dest": "frontend/assets/$1" },
    { "src": "/(.*)", "dest": "frontend/index.html" }
  ]
}
